---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cities, type City } from "../data/cities";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.path.replace(/^\//, "") },
    props: { city },
  }));
}

interface Props {
  city: City;
}

const { city } = Astro.props;
const pagePath = city.path;
const title = `Tile Contractor ${city.name}, CA | Pro Tiling`;
const description = city.description;
const canonical = `https://www.protiling.com${city.path}/`;
const ogTitle = city.ogTitle ?? title;
const ogDescription = city.ogDescription ?? city.description;
const ogType = "website";
const ogUrl = canonical;

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.protiling.com/#business",
  name: "Pro Tiling",
  telephone: "(916) 432-0365",
  url: "https://www.protiling.com/",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sacramento",
    addressRegion: "CA",
    addressCountry: "US",
  },
  areaServed: {
    "@type": city.areaType,
    name: city.name,
  },
  description: city.description,
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: city.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
});

const neighborItems = city.neighbors.map((name) => {
  const match = cities.find((c) => c.name === name);
  return { name, path: match?.path };
});
---
<BaseLayout
  pagePath={pagePath}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  ogUrl={ogUrl}
  schemaScripts={[localBusinessSchema, faqSchema]}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>›</span>
          <a href="/service-areas">Service Areas</a><span>›</span>
          <span>{city.name}</span>
        </nav>
        <h1>Tile Contractor in {city.name}, CA</h1>
        <p>{city.intro}</p>
        <div class="page-hero__cta">
          <a href="/contact" class="btn btn--primary">Get a Free Estimate</a>
          <a href="tel:9164320365" class="btn btn--outline">Call (916) 432-0365</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-body" style="max-width:820px;">
        {city.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        <h2>Tile Services in {city.name}</h2>
        <p>
          Pro Tiling provides specialized tile work for {city.name} homeowners.
          Explore our core services:
        </p>
        <ul>
          {city.services.map((service) => (
            <li>
              <a href={service.href}>{service.label}</a>
            </li>
          ))}
        </ul>

        <h2>Serving {city.name} and Nearby Areas</h2>
        <p>
          Alongside {city.name}, we regularly work in nearby communities including{" "}
          {neighborItems.map((n, i) => (
            <>{i > 0 && (i === neighborItems.length - 1 ? ", and " : ", ")}{n.path ? <a href={n.path}>{n.name}</a> : n.name}</>
          ))}{". See the full list on our "}
          <a href="/service-areas">service areas</a> page.
        </p>

        <div class="faq">
          <h2 style="margin-bottom:8px;">{city.name} Tile Questions</h2>
          {city.faqs.map((faq) => (
            <div class="faq-item">
              <button class="faq-item__question" aria-expanded="false">
                {faq.question}
                <span class="faq-item__icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p>{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <h2>Ready for tile work in {city.name}? <em>Let's talk.</em></h2>
        <div class="cta-band__actions">
          <a href="/contact" class="btn btn--primary">Free Estimate</a>
          <a href="tel:9164320365" class="btn btn--outline">Call (916) 432-0365</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
