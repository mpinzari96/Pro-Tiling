---
import BaseLayout from "../layouts/BaseLayout.astro";

const pagePath = "/about";
const title = "About Pro Tiling | Florin Rosco — Sacramento Tile Contractor";
const description = "Meet Florin Rosco, licensed and bonded owner of Pro Tiling. 10+ years of kitchen and bathroom remodel expertise across tile, floors, backsplashes, and fireplaces in Sacramento.";
const canonical = "https://www.protiling.com/about";
const ogTitle = "About Florin Rosco | Pro Tiling Sacramento";
const ogDescription = "Licensed and bonded tile contractor with 10+ years of experience specializing in kitchen and bathroom remodels from start to finish.";
const ogType = "website";
const ogUrl = "https://www.protiling.com/about";
---
<BaseLayout
  pagePath={pagePath}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  ogUrl={ogUrl}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>›</span><span>About</span>
        </nav>
        <h1>Sacramento's Tile Contractor, Built on Craft</h1>
        <p>Our team is led by Florin Rosco, a licensed and bonded tile contractor with over 10 years of experience. We specialize in kitchen and bathroom remodels from start to finish — including tile, floors, backsplashes, and fireplaces.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-intro animate-on-scroll">
        <div class="about-img-wrap">
          <img
            src="/florin-rosco.webp"
            alt="Florin Rosco, owner and licensed tile contractor at Pro Tiling in Sacramento"
            loading="lazy"
            width="700"
            height="875"
          />
          <div class="why-grid__img-badge" style="bottom:-16px;left:0;right:auto;">
            <strong>10+</strong>
            <span>Years<br>Experience</span>
          </div>
        </div>
        <div>
          <span class="section-label">Meet Florin</span>
          <h2>Owner &amp; Lead Tile Contractor</h2>
          <p class="lead" style="margin-top:16px;">Over 10 years ago, I decided to take on the task of improving the quality of tile work. Early in my journey, I noticed that previous tile work done by others had not met clients' expectations — mechanically or design-wise. I took it upon myself to deliver the best results for my clients.</p>
          <p style="margin-top:16px;font-size:0.9375rem;color:var(--mid-gray);line-height:1.8;">We specialize in kitchen and bathroom remodels from start to finish. Our services include tile, floors, backsplashes, and fireplaces — and we have the skills and expertise to handle even the most complex projects.</p>
          <p style="margin-top:14px;font-size:0.9375rem;color:var(--mid-gray);line-height:1.8;">Here at Pro Tiling, we use only the highest quality materials and are committed to delivering exceptional results on every job.</p>
          <div class="trust-badges" style="justify-content:flex-start;margin-top:28px;">
            <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Licensed &amp; Bonded</div>
            <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Fully Insured</div>
            <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>5-Star Rated</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--gray" aria-labelledby="values-heading">
    <div class="container">
      <div class="text-center animate-on-scroll">
        <span class="section-label">How We Work</span>
        <h2 id="values-heading">The Standards We Hold Ourselves To</h2>
        <p style="max-width:480px;margin:12px auto 0;">Every job we take on, no matter the size, gets our full attention. These are the principles that guide how we work.</p>
      </div>
      <div class="about-values animate-on-scroll">
        <div class="value-card">
          <h4>Waterproofing First</h4>
          <p>We never skip or shortchange the waterproofing step. It's not visible in the final result — but it's the difference between a shower that lasts 20 years and one that fails in 3.</p>
        </div>
        <div class="value-card">
          <h4>Honest Estimates</h4>
          <p>We give you a detailed, written estimate before any work begins. If scope changes during the project, we tell you before we do the work — not after.</p>
        </div>
        <div class="value-card">
          <h4>Clean Job Sites</h4>
          <p>We protect surrounding surfaces, contain the work area, and clean up every day before we leave. Your home doesn't become a construction site just because we're in it.</p>
        </div>
        <div class="value-card">
          <h4>Precision Over Speed</h4>
          <p>We're not the fastest crew in Sacramento — we're the most careful. Layout planning, consistent joint spacing, and perfectly cut edges take time. That time shows in the finished product.</p>
        </div>
        <div class="value-card">
          <h4>Direct Communication</h4>
          <p>When you call Pro Tiling, you talk to us. Not a dispatcher, not an answering service. We keep you informed throughout the project and respond quickly to questions.</p>
        </div>
        <div class="value-card">
          <h4>We Stand Behind Our Work</h4>
          <p>If something isn't right after we leave, we come back and make it right. No runaround. That's a simple promise, and we keep it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-about-heading">
    <div class="container text-center animate-on-scroll">
      <span class="section-label">Service Area</span>
      <h2 id="areas-about-heading">Proud to Serve Greater Sacramento</h2>
      <p style="max-width:520px;margin:14px auto 28px;">We work throughout the Sacramento metro and surrounding communities. If you're outside our typical range, call us — we'll let you know if we can make it work.</p>
      <div class="areas-grid" style="max-width:720px;margin:0 auto;">
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Sacramento</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Elk Grove</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Roseville</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Folsom</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Natomas</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Rancho Cordova</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Citrus Heights</div>
        <div class="area-chip" style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);">Rocklin</div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <h2>Let's work together on your <em>next tile project</em>.</h2>
        <div class="cta-band__actions">
          <a href="tel:9164320365" class="btn btn--primary">(916) 432-0365</a>
          <a href="/contact" class="btn btn--outline">Free Estimate</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
