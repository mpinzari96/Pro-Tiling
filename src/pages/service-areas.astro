---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cities } from "../data/cities";

const pagePath = "/service-areas";
const title = "Tile Contractor Service Areas | Sacramento Region | Pro Tiling";
const description =
  "Pro Tiling serves Sacramento and the greater region — Elk Grove, Roseville, Folsom, Rancho Cordova, Citrus Heights, and more. Request free tile estimates.";
const canonical = "https://www.protiling.com/service-areas/";
const ogTitle = title;
const ogDescription = description;
const ogType = "website";
const ogUrl = canonical;

const schemaScripts = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://www.protiling.com/#business",
    name: "Pro Tiling",
    telephone: "(916) 432-0365",
    url: "https://www.protiling.com/",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Sacramento",
      addressRegion: "CA",
      addressCountry: "US",
    },
    description:
      "Pro Tiling is a Sacramento-area tile contractor serving cities across the greater Sacramento region.",
    areaServed: cities.map((city) => ({
      "@type": city.areaType,
      name: city.name,
    })),
  }),
];

const serviceLinks = [
  { href: "/tile-installation-sacramento", label: "Tile Installation" },
  { href: "/bathroom-tile-sacramento", label: "Bathroom Tile Remodeling" },
  { href: "/shower-tile-installation-sacramento", label: "Shower Tile Installation" },
  { href: "/backsplash-installation-sacramento", label: "Kitchen Backsplash" },
];
---
<BaseLayout
  pagePath={pagePath}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  ogUrl={ogUrl}
  schemaScripts={schemaScripts}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>›</span><span>Service Areas</span>
        </nav>
        <h1>Tile Contractor Service Areas</h1>
        <p>
          Pro Tiling covers the greater Sacramento region — from Elk Grove and Roseville to Folsom,
          the foothills, and Solano County communities along I-80. Wherever you are on the map below,
          we bring the same waterproofing standards and clean finishes.
        </p>
        <div class="page-hero__cta">
          <a href="/contact" class="btn btn--primary">Get a Free Estimate</a>
          <a href="tel:9164320365" class="btn btn--outline">Call (916) 432-0365</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="text-center animate-on-scroll">
        <span class="section-label">Where We Work</span>
        <h2>Cities & Communities We Serve</h2>
        <p style="max-width:560px;margin:14px auto 0;">
          Select your city for local details, nearby areas, and how we approach tile projects there.
        </p>
      </div>
      <div class="areas-grid" role="list" style="margin-top:40px;">
        {cities.map((city) => (
          <a
            href={city.path}
            class="area-chip"
            role="listitem"
            style="background:var(--off-white);border-color:var(--light-gray);color:var(--charcoal);text-decoration:none;"
          >
            {city.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <div class="text-center animate-on-scroll">
        <span class="section-label">Coverage Map</span>
        <h2>Greater Sacramento Region</h2>
        <p style="max-width:520px;margin:14px auto 28px;">
          Our crew is based in Sacramento and regularly travels throughout the metro and nearby counties.
        </p>
      </div>
      {/* TODO: Replace this Sacramento metro embed with a custom service-area map when ready. */}
      <div class="map-placeholder" style="height:360px;max-width:900px;margin:0 auto;">
        <iframe
          title="Pro Tiling Sacramento region service area map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d85000!2d-121.4944!3d38.5816!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x809ac672b28397f9%3A0x921f6aaa74197fdb!2sSacramento%2C%20CA!5e0!3m2!1sen!2sus!4v1234567890"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          aria-label="Map showing Pro Tiling service area in the greater Sacramento region"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-body" style="max-width:820px;">
      <h2>Tile Services Across Our Service Area</h2>
      <p>
        Every city page links into our core service offerings. Start here if you already know the type of work you need:
      </p>
      <ul>
        {serviceLinks.map((service) => (
          <li>
            <a href={service.href}>{service.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <h2>Not sure if we cover your street? <em>Ask us.</em></h2>
        <div class="cta-band__actions">
          <a href="/contact" class="btn btn--primary">Free Estimate</a>
          <a href="tel:9164320365" class="btn btn--outline">Call (916) 432-0365</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
