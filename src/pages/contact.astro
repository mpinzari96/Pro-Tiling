---
import BaseLayout from "../layouts/BaseLayout.astro";
import EstimateForm from "../components/EstimateForm.astro";
import { SITE_URL } from "../data/site";

const pagePath = "/contact";
const title = "Contact Pro Tiling Sacramento | Free Tile Estimate";
const description =
  "Request a free tile estimate from Pro Tiling in Sacramento. Call (916) 432-0365 for bathroom, shower, floor, and backsplash projects across Elk Grove, Roseville, and Folsom.";
const canonical = `${SITE_URL}/contact/`;
const ogTitle = title;
const ogDescription = description;
const ogType = "website";
const ogUrl = canonical;
const schemaScripts = [];
---

<BaseLayout
  pagePath={pagePath}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  ogUrl={ogUrl}
  schemaScripts={schemaScripts}
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>›</span><span>Contact</span>
        </nav>
        <h1>Get a Free Tile Estimate</h1>
        <p>Tell us about your project and we'll get back to you within one business day. No obligation, no hard sell — just an honest assessment of your project and what it will take to do it right.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-info animate-on-scroll" style="max-width:720px;">
        <span class="section-label">Reach Us Directly</span>
        <h2>We'd Love to Hear About Your Project</h2>
        <p>Whether you're ready to start immediately or still in the planning stage, reach out. We'll help you think through the project, choose the right tile approach, and give you an honest number.</p>
        <div class="contact-details">
          <div class="contact-detail">
            <div class="contact-detail__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"></path></svg>
            </div>
            <div>
              <div class="contact-detail__label">Phone</div>
              <div class="contact-detail__value"><a href="tel:9164320365" style="color:inherit;">(916) 432-0365</a></div>
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <div class="contact-detail__label">Email</div>
              <div class="contact-detail__value"><a href="mailto:protiling23@gmail.com" style="color:inherit;">protiling23@gmail.com</a></div>
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div>
              <div class="contact-detail__label">Business Hours</div>
              <div class="contact-detail__value">Monday–Friday: 8 AM–5 PM</div>
              <div style="font-size:0.875rem;color:var(--mid-gray);margin-top:2px;">Saturday: Closed</div>
              <div style="font-size:0.875rem;color:var(--mid-gray);margin-top:2px;">Sunday: Closed</div>
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <div class="contact-detail__label">Service Area</div>
              <div class="contact-detail__value">Greater Sacramento, CA</div>
              <div style="font-size:0.875rem;color:var(--mid-gray);margin-top:2px;">Elk Grove · Roseville · Folsom · Natomas · Rancho Cordova · Citrus Heights · Rocklin</div>
            </div>
          </div>
        </div>

        <div class="map-placeholder">
          <iframe
            title="Pro Tiling Sacramento location map"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d85000!2d-121.4944!3d38.5816!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x809ac672b28397f9%3A0x921f6aaa74197fdb!2sSacramento%2C%20CA!5e0!3m2!1sen!2sus!4v1234567890"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            aria-label="Map showing Pro Tiling service area in Sacramento, CA">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <EstimateForm />

  <section class="section--tight section--gray">
    <div class="container">
      <div class="trust-badges" style="justify-content:center;">
        <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>CA Licensed Contractor</div>
        <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Fully Insured</div>
        <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>5-Star Google Rated</div>
        <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>10+ Years Experience</div>
        <div class="trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path></svg>Same-Day Response</div>
      </div>
    </div>
  </section>
</BaseLayout>
