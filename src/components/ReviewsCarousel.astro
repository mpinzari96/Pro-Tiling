---
import { reviews } from "../data/reviews";

const star = '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
const stars = star.repeat(5);
---

<div class="reviews-carousel" role="region" aria-label="Customer reviews">
  <div class="reviews-carousel__track" tabindex="0">
    {reviews.map((review) => (
      <div class="reviews-carousel__slide">
        <div class="testimonial-card">
          <div class="testimonial-card__stars" set:html={stars} />
          <blockquote>"{review.quote}"</blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar">{review.initials}</div>
            <div>
              <div class="testimonial-card__name">{review.name}</div>
              {review.location && <div class="testimonial-card__location">{review.location}</div>}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="reviews-carousel__controls">
    <button type="button" class="reviews-carousel__btn" data-dir="-1" aria-label="Previous reviews">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button type="button" class="reviews-carousel__btn" data-dir="1" aria-label="Next reviews">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </div>
</div>

<script is:inline>
  document.querySelectorAll(".reviews-carousel").forEach(function (root) {
    var track = root.querySelector(".reviews-carousel__track");
    if (!track) return;
    root.querySelectorAll(".reviews-carousel__btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var slide = track.querySelector(".reviews-carousel__slide");
        var gap = parseFloat(getComputedStyle(track).gap) || 0;
        var width = slide ? slide.getBoundingClientRect().width + gap : track.clientWidth;
        track.scrollBy({ left: Number(btn.getAttribute("data-dir")) * width, behavior: "smooth" });
      });
    });
  });
</script>
